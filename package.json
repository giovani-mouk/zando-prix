{
  "name": "zando-prix",
  "version": "0.4.0",
  "description": "Comparateur de prix des produits de base entre marchés",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:schema": "node scripts/db.js schema",
    "db:seed": "node scripts/db.js seed",
    "db:reset": "node scripts/db.js reset",
    "admin:creer": "node scripts/admin.js creer",
    "admin:lister": "node scripts/admin.js lister",
    "admin:mot-de-passe": "node scripts/admin.js mot-de-passe",
    "admin:desactiver": "node scripts/admin.js desactiver",
    "admin:reactiver": "node scripts/admin.js reactiver",
    "test": "cucumber-js",
    "test:dry": "cucumber-js --dry-run",
    "test:a-valider": "cucumber-js --tags @a-valider",
    "cdn:integrite": "node scripts/integrite-cdn.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "pg": "^8.13.0"
