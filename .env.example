# Copier ce fichier en .env et adapter le mot de passe.
#
# En local : PostgreSQL installé sur votre machine.
# Sur Render : ce fichier n'est pas utilisé. render.yaml relie DATABASE_URL
# à la base Render, et les autres variables se règlent dans le tableau de bord.

# Format d'une URL de connexion :
#   postgres://utilisateur:motdepasse@machine:port/base
# Le port par défaut de PostgreSQL est 5432 ; il peut différer sur votre
# machine (5433 si deux versions de PostgreSQL sont installées).
# Un caractère spécial dans le mot de passe (# @ : / ?) doit être encodé
# (# devient %23) ou, plus simple, évité.

# Base de développement (données de seed.sql)
DATABASE_URL=postgres://postgres:motdepasse@localhost:5432/zando_prix

# Base dédiée aux tests : elle est VIDÉE avant chaque scénario.
# Elle doit être différente de DATABASE_URL, et toujours locale.
TEST_DATABASE_URL=postgres://postgres:motdepasse@localhost:5432/zando_prix_test

# Port du serveur local : http://localhost:3000
PORT=3000

# Photos de preuve (facultatif) : tableau de bord Cloudinary > « API Environment variable »
# CLOUDINARY_URL=cloudinary://CLE:SECRET@NOM_DU_COMPTE
